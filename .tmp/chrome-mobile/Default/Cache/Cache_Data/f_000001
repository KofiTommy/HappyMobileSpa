.featured-treatment{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(220px,.7fr);gap:36px;align-items:end;margin-bottom:24px;padding:clamp(28px,4vw,52px);border-radius:var(--radius);background:var(--forest);color:#DDE7E0;overflow-wrap:anywhere}.featured-treatment .featured-label{margin-bottom:22px;color:#B7D5BF;font-size:.68rem;font-weight:500;letter-spacing:.17em;text-transform:uppercase}.featured-treatment h3{margin-bottom:18px;color:var(--ivory);font-size:clamp(2.3rem,3.5vw,4rem)}.featured-treatment p{margin-bottom:0}.featured-booking .service-facts{display:flex;justify-content:space-between;gap:20px;margin-bottom:24px;padding-top:20px;border-top:1px solid #faf7f033}.featured-booking .service-facts strong{color:var(--ivory);font-family:var(--display);font-size:1.6rem;font-weight:400}.featured-booking .button{width:100%;gap:16px}.treatment-card .service-facts{display:flex;justify-content:space-between;gap:16px}.treatment-card .service-facts strong{color:var(--forest);font-family:var(--display);font-size:1.4rem;font-weight:400}.treatment-card .text-link{display:inline-flex;align-items:center;gap:12px;align-self:flex-start;margin-top:20px}.text-link svg{width:18px;height:18px;flex-shrink:0}.team-section>.section-index,.home-gallery>.section-index,.home-faq>.section-index{grid-column:1/4}.team-content,.home-gallery-content,.home-faq>div{grid-column:4/13}.team-content .section-heading-row>p{max-width:390px;margin:0}.team-card{min-width:0}.team-card h3{margin:18px 0 0;font-size:1.65rem}.home-gallery-grid figure{margin:0;min-width:0}.home-gallery-grid img{width:100%;aspect-ratio:4/3;border-radius:var(--radius);object-fit:cover}.home-faq>div>h2{margin-bottom:45px}.home-faq details:last-child{border-bottom:1px solid var(--line)}.home-faq summary svg{width:24px;height:24px;flex-shrink:0;transition:transform .25s}.home-faq details[open] summary svg{transform:rotate(45deg)}.home-faq details p{max-width:720px;margin:18px 0 0}
@media(max-width:900px){.treatment-cards,.team-grid,.home-gallery-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.trust-strip{grid-template-columns:repeat(2,1fr)}.featured-treatment{grid-template-columns:1fr}.team-content .section-heading-row{align-items:flex-start;flex-direction:column}}
@media(max-width:560px){.treatment-cards,.team-grid,.home-gallery-grid,.trust-strip{grid-template-columns:1fr}.trust-strip span{justify-content:flex-start;border-right:0;border-bottom:1px solid var(--line)}.treatment-card{padding:24px}.featured-treatment{padding:28px 24px}.featured-booking .button{font-size:.68rem}.team-card h3{font-size:1.5rem}}

.catalog-card{display:grid;grid-template-columns:48px minmax(0,1fr) minmax(180px,.35fr) auto;gap:24px;align-items:center;padding:30px;margin-bottom:16px;border:1px solid var(--line);border-radius:var(--radius);background:#ffffff80}.catalog-card h2{font-size:2.2rem}.catalog-card-facts{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:0}.catalog-card-facts dt{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted)}.catalog-card-facts dd{margin:4px 0 0;color:var(--forest);font-weight:500}.content-panel,.form-panel,.contact-methods{padding:clamp(24px,4vw,52px);border:1px solid var(--line);border-radius:var(--radius);background:#ffffff80}.contact-methods{display:grid;gap:22px}.contact-method{display:grid;grid-template-columns:28px 1fr;gap:14px}.contact-method svg{width:24px;height:24px;color:var(--leaf)}.empty-state{padding:clamp(30px,5vw,60px);border:1px solid var(--line);border-radius:var(--radius);background:var(--sand)}
.about-split>.content-panel,.contact-grid>.contact-methods{padding:clamp(24px,4vw,52px);background:#ffffff80}.contact-method h2{margin:0 0 8px}.contact-method p{margin:0}.managed-gallery .empty-state{grid-column:1/-1}
@media(max-width:1000px){.catalog-card{grid-template-columns:40px 1fr auto}.catalog-card-facts{grid-column:2/3}.catalog-card .button{grid-column:3;grid-row:1/3}}
@media(max-width:640px){.catalog-card{grid-template-columns:1fr;padding:24px}.catalog-card-facts,.catalog-card .button{grid-column:1;grid-row:auto}.catalog-card .treatment-number{display:none}}
@media(max-width:390px){.brand span{display:none}}

/* Premium homepage editorial refresh */
.page-index{--gold:#CBA46A;--blush:#F0E2D8;--deep:#102F27}
.page-index .hero{isolation:isolate;min-height:calc(100svh - 88px);padding:clamp(24px,3vw,48px) var(--page) clamp(68px,7vw,100px);background:radial-gradient(circle at 12% 25%,rgba(203,164,106,.13),transparent 30%),linear-gradient(135deg,#FAF7F0 0%,#F7F2E8 58%,#E9E2D4 100%)}
.page-index .hero::before{content:'';position:absolute;z-index:-1;left:-110px;bottom:-180px;width:420px;height:420px;border:1px solid rgba(23,63,53,.09);border-radius:50%;box-shadow:0 0 0 55px rgba(23,63,53,.025),0 0 0 110px rgba(23,63,53,.018)}
.page-index .hero-copy{grid-column:1/7;padding:clamp(38px,5vw,82px) clamp(30px,4.5vw,74px) 40px 0}
.page-index .hero-copy h1{max-width:760px;text-wrap:balance}
.page-index .hero-copy h1 em{color:#A8463B}
.page-index .hero-copy .eyebrow{margin-bottom:clamp(24px,3vw,42px);color:#8F4A3F}
.page-index .hero-intro{max-width:510px}
.page-index .hero-visual{grid-column:7/13;min-height:clamp(590px,70vh,760px);border-radius:30px 30px 120px 30px;box-shadow:0 35px 90px rgba(23,63,53,.2)}
.page-index .hero-visual::after{background:linear-gradient(180deg,rgba(16,47,39,.03),transparent 45%,rgba(16,47,39,.32))}
.page-index .hero-slide img{transition:transform 8s cubic-bezier(.2,.7,.2,1)}
.page-index .hero-slide.is-active img{transform:scale(1.035)}
.page-index .hero-caption{right:0;bottom:0;width:min(350px,82%);padding:24px 28px;border-radius:20px 0 0 0;background:rgba(250,247,240,.96);backdrop-filter:blur(12px)}
.page-index .hero-seal{left:calc(50% - 48px);bottom:52px;width:104px;height:104px;border:6px solid var(--ivory);background:var(--gold);color:var(--deep);box-shadow:0 12px 30px rgba(23,63,53,.18)}
.page-index .trust-strip{position:relative;z-index:5;margin-top:-32px;margin-bottom:20px;border:0;background:rgba(255,255,255,.9);box-shadow:0 18px 50px rgba(23,63,53,.1);backdrop-filter:blur(12px)}
.page-index .trust-strip span{min-height:88px}
.experience-section{position:relative;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(45px,7vw,110px);margin:40px var(--page) 30px;padding:clamp(50px,7vw,100px);overflow:hidden;border-radius:32px;background:radial-gradient(circle at 0 100%,rgba(203,164,106,.16),transparent 38%),var(--deep);color:#DDE7E0}
.experience-section::after{content:'REST';position:absolute;right:-20px;bottom:-70px;color:rgba(250,247,240,.035);font-family:var(--display);font-size:clamp(10rem,23vw,23rem);line-height:1;pointer-events:none}
.experience-heading,.experience-steps{position:relative;z-index:1}
.experience-heading h2{margin-bottom:28px;color:var(--ivory);font-size:clamp(3.2rem,5vw,5.8rem)}
.experience-heading h2 em{color:var(--gold)}
.experience-heading>p:last-child{max-width:430px;margin:0;color:#BFCFC5}
.experience-heading .eyebrow{color:var(--gold)}
.experience-steps{display:grid;align-content:center;gap:0;margin:0;padding:0;list-style:none}
.experience-steps li{display:grid;grid-template-columns:48px 1fr;gap:22px;padding:26px 0;border-top:1px solid rgba(250,247,240,.18)}
.experience-steps li:last-child{border-bottom:1px solid rgba(250,247,240,.18)}
.experience-steps li>span{padding-top:4px;color:var(--gold);font-size:.7rem;letter-spacing:.16em}
.experience-steps h3{margin:0 0 9px;color:var(--ivory);font-family:var(--body);font-size:.9rem;font-weight:500;letter-spacing:.12em;text-transform:uppercase}
.experience-steps p{max-width:540px;margin:0;color:#C5D3CA;font-size:.94rem}
.page-index .treatments{padding-top:100px}
.page-index .featured-treatment{grid-template-columns:minmax(250px,.95fr) minmax(280px,1.1fr) minmax(220px,.68fr);gap:0;align-items:stretch;margin-bottom:28px;padding:0;overflow:hidden;border-radius:28px;background:var(--deep);box-shadow:0 24px 60px rgba(23,63,53,.13)}
.featured-treatment-media{position:relative;min-height:390px;overflow:hidden}
.featured-treatment-media img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.22,1,.36,1)}
.featured-treatment-media:hover img{transform:scale(1.045)}
.featured-treatment-media::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(16,47,39,.05),rgba(16,47,39,.32));pointer-events:none}
.featured-treatment-media>span{position:absolute;top:22px;left:22px;z-index:1;padding:9px 14px;border-radius:999px;background:rgba(250,247,240,.94);color:var(--forest);font-size:.65rem;font-weight:500;letter-spacing:.13em;text-transform:uppercase}
.featured-treatment-copy{align-self:center;padding:clamp(32px,3.5vw,54px)}
.page-index .featured-treatment .featured-label{color:var(--gold)}
.featured-treatment-copy>p:last-child{color:#C5D3CA}
.page-index .featured-booking{display:flex;flex-direction:column;justify-content:center;padding:clamp(28px,3vw,44px);background:rgba(0,0,0,.13)}
.page-index .featured-booking .service-facts{margin:0 0 28px}
.page-index .treatment-card{position:relative;padding:32px;border-color:rgba(23,63,53,.13);border-radius:20px;background:rgba(255,255,255,.65);transition:transform .3s,border-color .3s,box-shadow .3s,background .3s}
.page-index .treatment-card:hover{transform:translateY(-6px);border-color:rgba(23,63,53,.28);background:#fff;box-shadow:0 20px 45px rgba(23,63,53,.1)}
.treatment-card-number{display:block;margin-bottom:30px;color:#A8463B;font-size:.68rem;letter-spacing:.16em}
.page-index .treatment-card h3{font-size:2.1rem}
.page-index .team-section{margin-top:80px;padding-top:100px;padding-bottom:110px;background:linear-gradient(180deg,#EEE8DC 0%,#F6F1E7 100%)}
.page-index .team-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:20px}
.team-portrait{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:180px 180px 20px 20px;background:var(--sage);box-shadow:0 12px 30px rgba(23,63,53,.08)}
.team-portrait img,.team-portrait .team-initials{width:100%;height:100%;aspect-ratio:auto;border-radius:0;object-fit:cover;transition:transform .6s cubic-bezier(.22,1,.36,1)}
.team-card:hover .team-portrait img{transform:scale(1.035)}
.team-portrait>span{position:absolute;right:12px;bottom:12px;left:12px;padding:9px 12px;border-radius:999px;background:rgba(250,247,240,.9);color:var(--forest);font-size:.62rem;font-weight:500;letter-spacing:.13em;text-align:center;text-transform:uppercase;backdrop-filter:blur(8px)}
.page-index .team-card h3{margin-top:22px}
.page-index .team-card>p{margin:8px 0 0;color:var(--muted);font-size:.88rem;line-height:1.55}
.page-index .home-gallery{padding-top:110px;padding-bottom:110px}
.page-index .home-gallery-grid{grid-template-columns:repeat(12,minmax(0,1fr));gap:22px;align-items:stretch}
.page-index .home-gallery-grid figure{display:flex;flex-direction:column;margin:0}
.page-index .home-gallery-grid figure:first-child{grid-column:1/8;grid-row:1/3;height:100%}
.page-index .home-gallery-grid figure:nth-child(2),.page-index .home-gallery-grid figure:nth-child(3){grid-column:8/13}
.page-index .home-gallery-grid figure:nth-child(2){grid-row:1}
.page-index .home-gallery-grid figure:nth-child(3){grid-row:2}
.page-index .home-gallery-grid img{flex:1;width:100%;min-height:0;border-radius:20px;object-fit:cover}
.page-index .home-gallery-grid figure:first-child img{min-height:610px;aspect-ratio:auto}
.page-index .home-gallery-grid figure:nth-child(2) img,.page-index .home-gallery-grid figure:nth-child(3) img{aspect-ratio:16/9}
.home-gallery-grid figcaption{display:flex;align-items:center;gap:12px;padding:13px 2px 0;color:var(--forest);font-family:var(--display);font-size:1.25rem}
.home-gallery-grid figcaption span{color:#A8463B;font-family:var(--body);font-size:.62rem;letter-spacing:.12em}
.page-index .home-faq{padding-top:60px;padding-bottom:120px}
@media(max-width:1100px){
    .page-index .hero-copy{grid-column:1/7;padding-right:34px}
    .experience-section{grid-template-columns:1fr;gap:38px}
    .experience-heading>p:last-child{max-width:620px}
    .page-index .featured-treatment{grid-template-columns:1fr 1fr}
    .featured-treatment-media{grid-column:1/3;min-height:420px;max-height:540px}
    .page-index .team-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}
}
@media(max-width:760px){
    .page-index .hero{min-height:auto;padding:20px 20px 70px}
    .page-index .hero-copy{padding:48px 0 42px}
    .page-index .hero-copy h1{font-size:clamp(4rem,17vw,6.2rem)}
    .page-index .hero-visual{width:100%;min-height:510px;margin-left:0;border-radius:24px 24px 90px 24px}
    .page-index .hero-seal{right:20px;bottom:112px;left:auto;width:90px;height:90px}
    .page-index .hero-caption{width:78%;padding:19px 22px}
    .page-index .trust-strip{margin:0 20px 10px}
    .experience-section{grid-template-columns:1fr;gap:34px;margin:30px 12px 10px;padding:54px 26px;border-radius:26px}
    .experience-heading h2{font-size:clamp(3.3rem,14vw,5rem)}
    .experience-steps li{grid-template-columns:36px 1fr;gap:14px}
    .page-index .treatments{padding-top:80px}
    .page-index .featured-treatment{grid-template-columns:1fr;border-radius:22px}
    .featured-treatment-media{grid-column:auto;min-height:300px;max-height:none}
    .featured-treatment-copy,.page-index .featured-booking{padding:28px 24px}
    .page-index .team-section{margin-top:50px;padding-top:80px;padding-bottom:85px}
    .page-index .home-gallery{padding-top:80px;padding-bottom:70px}
    .page-index .home-gallery-grid{grid-template-columns:1fr;gap:28px}
    .page-index .home-gallery-grid figure:first-child,.page-index .home-gallery-grid figure:nth-child(2),.page-index .home-gallery-grid figure:nth-child(3){grid-column:1;grid-row:auto;height:auto}
    .page-index .home-gallery-grid figure:first-child img{min-height:0;aspect-ratio:4/3}
    .page-index .home-gallery-grid figure:nth-child(2) img,.page-index .home-gallery-grid figure:nth-child(3) img{aspect-ratio:4/3}
}
@media(max-width:560px){
    .page-index .team-grid{grid-template-columns:1fr}
    .page-index .team-card{max-width:430px}
    .page-index .treatment-card{padding:26px}
    .page-index .hero-actions{gap:22px}
}
@media(prefers-reduced-motion:reduce){.page-index .hero-slide.is-active img{transform:none}}
